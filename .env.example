DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=warehouse_stock
# Database cloud (Aiven): tempel isi file ca.pem (TLS wajib). Kosongkan untuk MySQL lokal.
DB_SSL_CA=
# Opsional: batas koneksi per server (default 10; di Vercel 5).
DB_CONNECTION_LIMIT=
# Opsional: detik antar-cek update dashboard. Kosong = otomatis (Vercel 15, lainnya 0 = realtime SSE).
LIVE_POLL_SECONDS=
APP_URL=http://localhost:3000
# Tambahkan origin HP HTTPS/LAN, dipisahkan koma; jangan pakai wildcard.
ALLOWED_ORIGINS=http://localhost:3000,http://192.168.1.10:3000
APP_TIMEZONE=Asia/Jakarta
SESSION_HOURS=12
# true untuk HTTPS; false hanya untuk pengujian HTTP LAN tepercaya.
COOKIE_SECURE=false
